# Copy to .env.local and fill in. Never commit values.
# Also set the NEXT_PUBLIC_* variables in the Netlify site's environment.

# Supabase project URL and publishable (anon) key. Used by the browser and server clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth client for Supabase Auth, wired into supabase/config.toml by the auth task, for local development.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
